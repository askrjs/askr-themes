  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "new:theme": "node ./scripts/new-theme.js",
    "clean": "npx --yes rimraf dist node_modules",
    "bench": "npm run bench:tier1 && npm run bench:tier2 && npm run bench:tier3",
    "bench:tier1": "cross-env NODE_ENV=production vp test bench --run --reporter=default --config vitest.bench.tier1.config.ts",
    "bench:tier2": "cross-env NODE_ENV=production vp test bench --run --reporter=default --config vitest.bench.tier2.config.ts",
    "bench:tier3": "cross-env NODE_ENV=production vp test bench --run --reporter=default --config vitest.bench.tier3.config.ts",
    "test": "npm run test:unit && npm run test:checks && npm run test:jsdom && npm run test:browser",
    "test:unit": "vp test run -c vitest.test.unit.config.ts",
    "test:jsdom": "cross-env NODE_ENV=production vp test run -c vitest.test.jsdom.config.ts",
    "test:browser": "playwright test",
    "test:forced-colors": "playwright test --project=forced-colors",
    "test:publint": "publint",
    "test:installed": "node tests/installed-types.js",
    "fmt": "vp fmt .",
    "lint": "vp lint .",
    "typecheck": "tsc -p tsconfig.pack.json --noEmit",
    "build": "vp pack",
    "pack:check": "node tests/package-artifacts.js",
    "test:bundle": "node tests/granular-bundle.js",
    "changelog:check": "node scripts/check-changelog.mjs",
    "check": "npm run changelog:check && npm run lint && npm run typecheck && npm test && npm run build && npm run test:installed && npm run test:publint && npm run pack:check && npm run test:bundle",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check",
    "test:checks": "vp test run -c vitest.test.checks.config.ts"
  },
  "devDependencies": {
    "@askrjs/askr": ">=0.4.0 <0.5.0",
    "@askrjs/ui": ">=0.4.0 <0.5.0",
    "@askrjs/vite": ">=0.4.0 <0.5.0",
    "@playwright/test": "1.63.0",
    "@tsdown/css": "0.22.14",
    "@types/node": "^26.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "axe-core": "^4.13.0",
    "cross-env": "^10.1.0",
    "jsdom": "^30.0.1",
    "publint": "^0.3.24",
    "tsdown": "0.22.14",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite-plus": "^0.3.1"
  },
  "peerDependencies": {
    "@askrjs/askr": ">=0.4.0 <0.5.0",
    "@askrjs/ui": ">=0.4.0 <0.5.0"

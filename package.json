{
  "name": "@askrjs/themes",
  "version": "0.0.26",
  "description": "Default theme tokens, styles, and component presets for Askr apps.",
  "keywords": [
    "askr",
    "css",
    "design-tokens",
    "themes"
  ],
  "homepage": "https://github.com/askrjs/askr-themes#readme",
  "bugs": {
    "url": "https://github.com/askrjs/askr-themes/issues"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "askrjs",
    "url": "https://github.com/askrjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/askrjs/askr-themes.git"
  },
  "files": [
    "capabilities.json",
    "dist",
    "src",
    "templates",
    "scripts/new-theme.js",
    "THEMING.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/css.d.ts",
      "default": "./src/index.css"
    },
    "./default": {
      "types": "./src/css.d.ts",
      "default": "./src/themes/default/index.css"
    },
    "./presets": {
      "types": "./src/css.d.ts",
      "default": "./src/themes/presets/index.css"
    },
    "./components": {
      "types": "./dist/components.d.ts",
      "import": "./dist/components.js"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "import": "./dist/theme.js"
    },
    "./ssr": {
      "types": "./dist/ssr.d.ts",
      "import": "./dist/ssr.js"
    },
    "./*": {
      "types": "./dist/entries/*.d.ts",
      "import": "./dist/entries/*.js"
    },
    "./default/tokens.css": {
      "types": "./src/css.d.ts",
      "default": "./src/themes/default/tokens.css"
    },
    "./default/foundations.css": {
      "types": "./src/css.d.ts",
      "default": "./src/themes/default/foundations.css"
    },
    "./default/input.css": {
      "types": "./src/css.d.ts",
      "default": "./src/themes/default/styles/forms/input.css"
    },
    "./default/label.css": {
      "types": "./src/css.d.ts",
      "default": "./src/themes/default/styles/forms/label.css"
    },
    "./default/styles/*": {
      "types": "./src/css.d.ts",
      "default": "./src/themes/default/styles/*"
    },
    "./templates/*": {
      "types": "./src/css.d.ts",
      "default": "./templates/*"
    },
    "./package.json": "./package.json",
    "./capabilities.json": "./capabilities.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "new:theme": "node ./scripts/new-theme.js",
    "clean": "npx --yes rimraf dist node_modules",
    "bench": "npm run bench:tier1 && npm run bench:tier2 && npm run bench:tier3 && npm run bench:tier4",
    "bench:tier1": "cross-env NODE_ENV=production vp test bench --run --reporter=default --config vitest.bench.tier1.config.ts",
    "bench:tier2": "cross-env NODE_ENV=production vp test bench --run --reporter=default --config vitest.bench.tier2.config.ts",
    "bench:tier3": "cross-env NODE_ENV=production vp test bench --run --reporter=default --config vitest.bench.tier3.config.ts",
    "bench:tier4": "cross-env NODE_ENV=production vp test bench --run --reporter=default --config vitest.bench.tier4.config.ts --mode production",
    "test": "npm run test:unit && npm run test:checks && npm run test:jsdom && npm run test:browser",
    "test:unit": "vp test run -c vitest.test.unit.config.ts",
    "test:jsdom": "cross-env NODE_ENV=production vp test run -c vitest.test.jsdom.config.ts",
    "test:browser": "vp test run -c vitest.test.browser.config.ts --mode production",
    "test:publint": "publint",
    "test:installed": "node tests/installed-types.js",
    "fmt": "vp fmt .",
    "lint": "vp lint .",
    "typecheck": "tsc -p tsconfig.pack.json --noEmit",
    "build": "vp pack",
    "pack:check": "node tests/package-artifacts.js",
    "test:bundle": "node tests/granular-bundle.js",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run test:installed && npm run test:publint && npm run pack:check && npm run test:bundle",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check",
    "test:checks": "vp test run -c vitest.test.checks.config.ts"
  },
  "devDependencies": {
    "@askrjs/askr": ">=0.0.88 <0.1.0",
    "@askrjs/ui": ">=0.0.26 <0.1.0",
    "@askrjs/vite": ">=0.0.12 <0.1.0",
    "@tsdown/css": "0.22.14",
    "@types/node": "^26.2.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/browser-playwright": "4.1.10",
    "cross-env": "^10.1.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "publint": "^0.3.23",
    "tsdown": "0.22.14",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite-plus": "^0.2.8"
  },
  "peerDependencies": {
    "@askrjs/askr": ">=0.0.88 <0.1.0",
    "@askrjs/ui": ">=0.0.26 <0.1.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@12.0.1"
}
